# 本地开发默认配置：SQLite + 免密登录。
# 账号密码不会写入数据库，登录页输入 admin 即可进入全权限后台。
APP_ENV=development
AUTH_MODE=passwordless
DEV_AUTH_USERNAME=admin
USE_SQLITE=true

# 只有切换到 AUTH_MODE=password 时才需要真正配置安全密钥。
SECRET_KEY=local-development-only-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 可选：切换到 PostgreSQL 时填写完整连接地址；默认不需要此项。
# DATABASE_URL=postgresql+psycopg2://postgres@localhost:5432/data_task_platform

# 默认不打印 SQL；排查数据库问题时可临时改为 true。
SQL_ECHO=false

# 语义匹配的可选 Embedding 配置；不配置时相关任务会跳过向量生成。
EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=
