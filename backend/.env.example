# 数据库配置
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/data_task_platform

# Embedding 配置
# 支持的 provider: openai, zhipu, deepseek, bge
EMBEDDING_PROVIDER=zhipu

# 智谱 AI (GLM-4) 配置 - 推荐，国内可用，免费额度高
# 支持模型: embedding-3 (1024维), embedding-2 (1024维)
# 注册获取 Key: https://open.bigmodel.cn
ZHIPU_API_KEY=your_zhipu_key_here
ZHIPU_EMBEDDING_MODEL=embedding-3
ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4

# OpenAI 配置（使用 OpenAI 时填写）
# OPENAI_API_KEY=your_api_key_here
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# DeepSeek 配置（使用 DeepSeek 时填写，注意：DeepSeek 暂无 embedding 接口）
# DEEPSEEK_API_KEY=your_deepseek_key_here
# DEEPSEEK_EMBEDDING_MODEL=deepseek-embedding

# BGE 配置（可选，使用本地/自托管 BGE 时需要）
BGE_API_KEY=
BGE_API_URL=http://localhost:8080

# 其他配置
# SECRET_KEY=your-secret-key-here
# DEBUG=True
